# ================================================================
# ANVESHA — Environment Configuration
# Copy this file to .env and fill in your API keys
# ================================================================

# --- Neo4j AuraDB (Free Tier) ---
# Get at: https://neo4j.com/cloud/aura-free/
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# --- Groq API (Primary LLM + Whisper ASR) ---
# Get at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key

# --- Google Gemini API (Verification + Vision + Embeddings) ---
# Get at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# --- OpenRouter (Fallback — Optional) ---
# Get at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Application Settings ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Model Overrides (Optional) ---
# GROQ_LLM_MODEL=llama-3.3-70b-versatile
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# GEMINI_MODEL=gemini-2.0-flash
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- GraphRAG Tuning (Optional) ---
# GRAPHRAG_K_HOPS=2
# GRAPHRAG_TOP_K_SEEDS=10
# GRAPHRAG_MAX_CONTEXT_NODES=50
